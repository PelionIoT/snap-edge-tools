REPO=PelionIoT/snap-edge-tools
KIND=tests
IMAGES=(
  "snap-edge-tools|pre-nucloud|Dockerfile|.|-|-"
)
PLATFORM=linux/amd64
# scripts/nucloud-test.sh runs the connectivity scripts in the image and on the gateway
# named in NUCLOUD_CONFIG_JSON. Run it with ACCOUNT=edge.
TEST_CMD=(scripts/nucloud-test.sh)
SMOKE_CMD=(sh -c 'for f in scripts/*.sh; do sh -n "$f" || exit 1; done; openssl version && echo smoke-ok')
CREDENTIALS=(API_KEY)
# Takes a shared lease on the stage's gateway for the run and checks its relay (nucloud scripts/edge-relay-preflight.py).
HOST_SETUP_CMD=(bash -c 'python3 ../../../nucloud/scripts/edge-relay-preflight.py --gateway "$MACHINE"')
SETUP_CMD=(python3 scripts/nucloud-setup.py)
# The gateway facts live in staging's edge account.
if [[ ( ${MACHINE:-} == staging || ${MACHINE:-} == k3s-golden ) && -z ${ACCOUNT:-} ]]; then export ACCOUNT=edge; fi
# The test account each stage uses (cloud.accounts.<name> facts); ACCOUNT= overrides.
ACCOUNTS=(staging=edge k3s-golden=edge)
